{% macro arrow() %}<svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></svg>{% endmacro %}
{% macro down() %}<svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v11M3.5 9 8 13.5 12.5 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></svg>{% endmacro %}
{% macro plus() %}<span class="plus" aria-hidden="true"></span>{% endmacro %}
{% macro eyebrow(text) %}<p class="eyebrow">{{ text }}</p>{% endmacro %}
{% macro section_text(section) %}
{% for p in section.paragraphs %}<p>{{ p }}</p>{% endfor %}
{% if section.bullets %}<ul>{% for b in section.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
{% endmacro %}
{% macro trend(direction) %}<svg class="trend trend--{{ direction }}" viewBox="16 6 70 88" aria-label="{{ direction }}" role="img"><g{% if direction == 'down' %} transform="translate(0 100) scale(1 -1)"{% endif %}><g transform="rotate(-14 50 50) translate(2 7.5)"><polyline points="10,74 45,34 53,53 76,23" fill="none" stroke="currentColor" stroke-width="5"/><polygon points="69,18 86,11 83,29" fill="currentColor" stroke="currentColor" stroke-width="5" stroke-linejoin="round"/></g></g></svg>{% endmacro %}
{% macro figure_icon(name) %}<svg class="figicon" viewBox="0 0 100 100" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="6" stroke-linejoin="round" stroke-linecap="round">{% if name == 'transactions' %}<path d="M12 34h70M66 18l16 16-16 16M88 66H18M34 50 18 66l16 16"/>{% elif name == 'star' %}<path d="M50 9l11.8 26.3 28.7 2.9-21.5 19.3 6.1 28.2L50 71.3 24.9 85.7l6.1-28.2L9.5 38.2l28.7-2.9Z" fill="currentColor"/>{% elif name == 'calendar' %}<rect x="14" y="20" width="72" height="66" rx="6"/><path d="M14 40h72M33 12v16M67 12v16"/>{% elif name == 'people' %}<circle cx="36" cy="36" r="12"/><path d="M12 84c0-15 11-26 24-26s24 11 24 26"/><circle cx="68" cy="32" r="10"/><path d="M60 54c2.5-1.5 5.3-2.3 8-2.3 11 0 20 9.3 20 22"/>{% elif name == 'engineers' %}<circle cx="50" cy="32" r="13"/><path d="M26 86c0-15 10.7-27 24-27s24 12 24 27"/><path d="M16 40 6 50l10 10M84 40l10 10-10 10"/>{% elif name == 'factory' %}<path d="M10 88V48l20 12V48l20 12V48l20 12V20h16v68Z"/><path d="M28 74h8M48 74h8M68 74h8"/>{% elif name == 'globe' %}<circle cx="50" cy="50" r="38"/><ellipse cx="50" cy="50" rx="16" ry="38"/><path d="M12 50h76M18 32h64M18 68h64"/>{% elif name == 'products' %}<path d="M50 10 88 29v42L50 90 12 71V29Z M12 29l38 19 38-19 M50 48v42"/>{% endif %}</svg>{% endmacro %}
