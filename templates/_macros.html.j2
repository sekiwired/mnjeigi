{% macro arrow() %}<svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></svg>{% endmacro %}
{% macro down() %}<svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v11M3.5 9 8 13.5 12.5 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></svg>{% endmacro %}
{% macro plus() %}<span class="plus" aria-hidden="true"></span>{% endmacro %}
{% macro eyebrow(text) %}<p class="eyebrow">{{ text }}</p>{% endmacro %}
{% macro section_text(section) %}
{% for p in section.paragraphs %}<p>{{ p }}</p>{% endfor %}
{% if section.bullets %}<ul>{% for b in section.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
{% endmacro %}
{% macro trend(direction) %}<svg class="trend trend--{{ direction }}" viewBox="16 6 70 88" aria-label="{{ direction }}" role="img"><g{% if direction == 'down' %} transform="translate(0 100) scale(1 -1)"{% endif %}><g transform="rotate(-14 50 50) translate(2 7.5)"><polyline points="10,74 45,34 53,53 76,23" fill="none" stroke="currentColor" stroke-width="5"/><polygon points="69,18 86,11 83,29" fill="currentColor" stroke="currentColor" stroke-width="5" stroke-linejoin="round"/></g></g></svg>{% endmacro %}
{% macro figure_icon(name) %}<svg class="figicon" viewBox="0 0 100 100" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="6" stroke-linejoin="round" stroke-linecap="round">{% if name == 'transactions' %}<path d="M12 34h70M66 18l16 16-16 16M88 66H18M34 50 18 66l16 16"/>{% elif name == 'star' %}<path d="M50 9l11.8 26.3 28.7 2.9-21.5 19.3 6.1 28.2L50 71.3 24.9 85.7l6.1-28.2L9.5 38.2l28.7-2.9Z" fill="currentColor"/>{% elif name == 'products' %}<path d="M50 10 88 29v42L50 90 12 71V29Z M12 29l38 19 38-19 M50 48v42"/>{% endif %}</svg>{% endmacro %}
